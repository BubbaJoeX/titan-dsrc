// Battle of Naboo heroic (docs/content/battle-of-naboo/README.md): a rally point (see the shared template).

@base object/tangible/base/tangible_base.iff

@class tangible_object_template 0

@class object_template 5

sharedTemplate = "object/tangible/titan/heroic/naboo/shared_rally_marker.iff"

invulnerable = true
persistByDefault = false

updateRanges [UR_near] = 512
updateRanges [UR_normal] = 1024
updateRanges [UR_far] = 1536
